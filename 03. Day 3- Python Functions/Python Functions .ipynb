    "#Pascal's Triangle\n",
    "from math import factorial\n",
    "def pascal_triangle(n):\n",
    "   for i in range(n):\n",
    "       for j in range(n-i+1):\n",
    "           print(end=' ')\n",
    "       for j in range(i+1):       \n",
    "           print(factorial(i)//(factorial(j)*factorial(i-j)), end=' ')\n",
    "       print()\n",
    "\n",
    "if __name__ == '__main__':\n",
    "   pascal_triangle(8)"
   ]
  }
